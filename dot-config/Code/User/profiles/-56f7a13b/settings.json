{
  "[git-commit]": {
    // "editor.rulers": [50, 78],
  },
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "containers.containerClient": "com.microsoft.visualstudio.containers.podman",
  "containers.orchestratorClient": "com.microsoft.visualstudio.orchestrators.podmancompose",
  "editor.formatOnSave": true,
  "editor.stickyScroll.enabled": false,
  "editor.tabSize": 2,
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.patterns": {
    "*.go": "${capture}_test.go, ${capture}_example_test.go",
    "*.ps1": "${capture}.Tests.ps1",
    "*.py": "${capture}_test.py, test_${capture}.py",
    "*.sh": "${capture}_test.bats",
    "*.tf": "${capture}_test.go",
  },
  "explorer.incrementalNaming": "smart",
  "files.autoSave": "onFocusChange",
  "files.insertFinalNewline": true,
  "files.simpleDialog.enable": true,
  "files.trimFinalNewlines": true,
  "files.trimTrailingWhitespace": true,
  "git.allowForcePush": true,
  "git.autofetch": true,
  "git.branchPrefix": "scratch/",
  // "git.branchProtection": ["main", "master"],
  "git.branchRandomName.enable": true,
  "git.confirmSync": false,
  "git.fetchOnPull": true,
  "git.mergeEditor": true,
  "git.pruneOnFetch": true,
  "git.replaceTagsWhenPull": true,
  "git.suggestSmartCommit": false,
  "git.terminalGitEditor": true,
  "terminal.integrated.stickyScroll.enabled": false,
  "workbench.colorCustomizations": {
    "activityBar.activeBackground": "#5d4495",
    // "activityBar.activeFocusBorder": "#00e47c",
    "activityBar.background": "#08312A",
    "titleBar.activeBackground": "#08312A",
    "titleBar.border": "#08312A",
    "window.activeBorder": "#00e47c",
    "window.inactiveBorder": "#e5e3de",
  },
  "workbench.colorTheme": "GitHub Dark High Contrast",
}
