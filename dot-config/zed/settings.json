// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)

// xx...xxxxxxxxxxxxxxxxxxxxxxxx... 80 chars ...xxxxxxxxxxxxxxxxxxxxxxxx...xx //

{
  "vim_mode": true,
  "autosave": "on_focus_change",
  "ui_font_size": 24,
  "buffer_font_size": 20,
  "cursor_shape": "bar",
  "close_panel_on_toggle": true,
  "relative_line_numbers": "disabled",
  "ensure_final_newline_on_save": true,
  "remove_trailing_whitespace_on_save": true,
  "format_on_save": "on",
  "show_whitespaces": "trailing",
  "which_key": {
    "enabled": true
  },
  "resize_all_panels_in_dock": ["left", "right", "bottom"],
  "rounded_selection": false,
  "minimap": { "show": "never" },
  "active_pane_modifiers": {
    "border_size": 10
    // "inactive_opacity": 0.7,
  },
  "bottom_dock_layout": "right_aligned",
  "buffer_line_height": "comfortable",
  // "buffer_line_height": { "custom": 1.5 },
  "auto_install_extensions": {
    "editorconfig": true
  },
  "file_finder": {
    "file_icons": true
  },
  "status_bar": {
    "active_encoding_button": "enabled",
    "line_endings_button": true
  },
  "debugger": { "dock": "right" },
  "tab_bar": { "show": false },
  "project_panel": { "dock": "right", "default_width": 240 },
  "git_panel": { "dock": "right", "default_width": 360 },
  "git": {
    "inline_blame": {
      "enabled": false
    }
  },
  "outline_panel": { "dock": "right", "default_width": 240 },
  "collaboration_panel": { "dock": "right", "default_width": 240 },
  "edit_predictions": {
    "provider": "copilot"
  },
  "session": { "restore_unsaved_buffers": true },
  "agent": {
    "tool_permissions": {
      "default": "confirm"
    },
    "default_profile": "write",
    "default_model": {
      "provider": "copilot_chat",
      "model": "gpt-5.1-codex-max",
      "enable_thinking": false,
      "effort": "high"
    },
    "dock": "left",
    "favorite_models": [
      {
        "provider": "copilot_chat",
        "model": "gpt-5-mini",
        "enable_thinking": false
      },
      {
        "provider": "copilot_chat",
        "model": "claude-opus-4.6",
        "enable_thinking": false
      }
    ],
    "model_parameters": []
  },
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "One Dark"
  },
  "icon_theme": {
    "mode": "dark",
    "light": "Zed (Default)",
    "dark": "Zed (Default)"
  },
  "profiles": {
    "Presentation": {
      // "theme": "One Light",
      "ui_font_size": 24,
      "buffer_font_size": 26,
      "redact_private_values": true,
      "relative_line_numbers": "disabled",
      "hide_mouse": "never",
      "hover_popover_enabled": false,
      "show_whitespaces": "none",
      "gutter": {
        "line_numbers": true,
        "runnables": false,
        "breakpoints": false,
        "folds": false
      },
      "indent_guides": { "enabled": false },
      "minimap": { "show": "always", "current_line_highlight": "none" },
      "title_bar": {
        "show_branch_icon": false,
        "show_branch_name": false,
        "show_menus": false,
        "show_onboarding_banner": false,
        "show_project_items": false,
        "show_sign_in": false,
        "show_user_menu": false,
        "show_user_picture": false
      },
      "tab_bar": { "show": false },
      "toolbar": {
        "agent_review": false,
        "breadcrumbs": false,
        "code_actions": false,
        "quick_actions": false,
        "selections_menu": false
      },
      "scrollbar": {
        "axes": {
          "horizontal": false
        }
      },
      "status_bar": {
        "active_encoding_button": "disabled",
        "active_language_button": false,
        "cursor_position_button": false,
        "line_endings_button": false
      }
    }
  }
}
